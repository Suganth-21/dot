# Copy to backend/.env and fill in real local values.
# backend/.env is gitignored — never commit real secrets.

# --- Phase 0: required ---
DATABASE_URL=postgresql+asyncpg://dot:dot@localhost:5432/dot
CORS_ORIGINS=http://localhost:3000

APP_NAME=DOT
APP_VERSION=0.1.0
ENVIRONMENT=development

# --- Phase 1: required (auth, demo login, demo reset) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7
# Encrypts each seeded entity's Ed25519 private key at rest (app/core/crypto.py).
SIGNING_MASTER_KEY=
DEMO_NOW=2026-09-15T09:30:00+05:30
# Gate the one-click demo logins / the "Reset demo data" button. Both ship
# false by default; set true only in demo/development environments.
ENABLE_DEMO_LOGIN=false
DEMO_PASSWORD=
ENABLE_DEMO_RESET=false

# --- Later phases: placeholders only, unused until their phase lands ---
# See ARCHITECTURE.md / BUILDPHASES.md for what each of these gates.
REDIS_URL=redis://localhost:6379/0
PUBLIC_VERIFY_RATE_LIMIT=30/minute
PUBLIC_REPORT_RATE_LIMIT=5/minute
